    "crear-usuario": "tsx --env-file=.env src/cli/crear-usuario.ts",
    "sembrar": "tsx --env-file=.env src/cli/sembrar.ts",
    "generar-migracion": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "restablecer-contrasena": "tsx --env-file=.env src/cli/restablecer-contrasena.ts",
    "desactivar-usuario": "tsx --env-file=.env src/cli/desactivar-usuario.ts",
    "crear-cliente": "tsx --env-file=.env src/cli/crear-cliente.ts",
    "crear-visita": "tsx --env-file=.env src/cli/crear-visita.ts",
    "reasignar-visita": "tsx --env-file=.env src/cli/reasignar-visita.ts",
    "publicar-formato": "tsx --env-file=.env src/cli/publicar-formato.ts",
    "publicar-simbolos": "tsx --env-file=.env src/cli/publicar-simbolos.ts",
    "crear-acceso-cliente": "tsx --env-file=.env src/cli/crear-acceso-cliente.ts",
    "regenerar-acceso-cliente": "tsx --env-file=.env src/cli/crear-acceso-cliente.ts --regenerar",
    "marcar-administrador": "tsx --env-file=.env src/cli/marcar-administrador.ts",
    "verificar-integridad": "tsx src/cli/verificar-integridad.ts",
    "crear-organizacion": "tsx --env-file=.env src/cli/crear-organizacion.ts",
    "generar-claves-avisos": "tsx src/cli/generar-claves-avisos.ts",
    "compilar": "node scripts/compilar.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
