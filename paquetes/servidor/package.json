    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.4",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@teins/dominio": "workspace:*",
    "@teins/protocolo": "workspace:*",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "file-type": "^22.1.1",
    "graphile-worker": "^0.18.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "playwright-core": "1.62.1",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.15"
  },
  "files": [
    "dist",
    "migraciones",
