# Copie este archivo a .env para desarrollo local. Nunca versione .env (AGENTS.md, regla 2).
# Los valores coinciden con docker-compose.yml y solo sirven en su máquina.

NODE_ENV=development
PUERTO=3000
NIVEL_REGISTRO=info

# Rol de la aplicación (seguridad por fila) y rol dueño (migraciones y cola)
DATABASE_URL=postgres://teins_app:app-local@localhost:5432/teins
DATABASE_URL_PROPIETARIO=postgres://teins_propietario:propietario-local@localhost:5432/teins

# Almacenamiento compatible con S3 (S3Mock en local)
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=teins-archivos
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_FORZAR_RUTA=true
# S3Mock ya permite subir desde cualquier origen y no admite configurar CORS
S3_CONFIGURAR_CORS=false

# Genere uno propio: openssl rand -base64 32
AUTH_SECRETO=
# Orígenes de campo y oficina en desarrollo
ORIGENES_CONFIABLES=http://localhost:5173,http://localhost:5174
