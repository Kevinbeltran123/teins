# Copie este archivo a .env para desarrollo local. Nunca versione .env (AGENTS.md, regla 2).
# Los valores coinciden con docker-compose.yml y solo sirven en su máquina.

NODE_ENV=development
PUERTO=3000
NIVEL_REGISTRO=info

# Rol de la aplicación (seguridad por fila) y rol dueño (migraciones y cola)
DATABASE_URL=postgres://teins_app:app-local@localhost:5432/teins
DATABASE_URL_PROPIETARIO=postgres://teins_propietario:propietario-local@localhost:5432/teins
# Rol exclusivo del portal del cliente (ADR-0009): solo ve versiones publicadas de su cliente
DATABASE_URL_PORTAL=postgres://teins_portal:portal-local@localhost:5432/teins

# Almacenamiento compatible con S3 (S3Mock en local)
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=teins-archivos
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_FORZAR_RUTA=true
# S3Mock ya permite subir desde cualquier origen y no admite configurar CORS
S3_CONFIGURAR_CORS=false

# Genere uno propio: openssl rand -base64 32
AUTH_SECRETO=
# Orígenes de campo, oficina y portal en desarrollo
ORIGENES_CONFIABLES=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Dirección del portal que lleva el QR de cada acceso de cliente
PORTAL_URL=http://localhost:5175

# Envío del informe al cliente (ADR-0028). En local se simulan: nada sale del servidor, y una
# dirección con "rebota" (o un celular que termina en 000) se rechaza para ver "No llegó".
ENVIOS_SIMULADOS=true
# Con cuentas reales (entorno de pruebas o producción), en lugar de simularlos:
# RESEND_CLAVE_API=re_...
# RESEND_SECRETO_EVENTOS=whsec_...
# CORREO_REMITENTE="TEINS <informes@dominio-verificado>"
# CORREO_RESPONDER_A=oficina@dominio
# WHATSAPP_TOKEN=...
# WHATSAPP_NUMERO_ID=...
# WHATSAPP_SECRETO_APP=...
# WHATSAPP_TOKEN_VERIFICACION=...
